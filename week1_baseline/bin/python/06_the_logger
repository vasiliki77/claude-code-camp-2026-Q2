#!/usr/bin/env bash
set -euo pipefail

# Repo root is three levels up from this script (bin/python/ -> bin -> week1_baseline -> root).
root="$(cd "$(dirname "$0")/../../.." && pwd)"
venv_python="$root/.venv/bin/python"

if [[ ! -x "$venv_python" ]]; then
  echo "No virtualenv found at $root/.venv" >&2
  echo "Create it once from the repo root:" >&2
  echo "  python3 -m venv .venv" >&2
  echo "  .venv/bin/pip install -r week1_baseline/python/06_the_logger/requirements.txt" >&2
  exit 1
fi

cd "$root/week1_baseline/python/06_the_logger"
exec "$venv_python" examples/example.py
