# Windows Zone.Identifier files (WSL download metadata)
*Zone.Identifier

# Environment / secrets
.env
.env.local

# Dependencies
node_modules/
__pycache__/
*.pyc

# Python virtual environments
.venv/
venv/

# Generated CircleMUD world data (regenerate via week0_explore/bin/convert-world)
week0_explore/preview/data/world/**/*.json

# Derived session rollup (rebuilt from .boukensha/sessions/*.jsonl, which stay
# tracked as the source of truth). Glob covers the -wal/-shm sidecars.
.boukensha/sessions.db*

# Metabase keeps its accounts, questions and dashboards in a docker volume
# rather than the repo — nothing to ignore here, but worth saying so it does not
# look forgotten. week2_capable/observability/provision.py rebuilds them.

*.gem
